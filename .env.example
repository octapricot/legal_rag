# ─────────────────────────────────────────────────────────────────────────────
# Legal RAG — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Backend ──────────────────────────────────────────────────────────────
# "ollama"  → local Mistral via Ollama (development)
# "api"     → Claude API via Anthropic (production)
LLM_BACKEND=ollama

# Ollama settings (used when LLM_BACKEND=ollama)
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic API settings (used when LLM_BACKEND=api)
ANTHROPIC_API_KEY=          # sk-ant-...
API_MODEL=claude-haiku-4-5-20251001

# ── Data Paths ───────────────────────────────────────────────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
INDEX_DIR=data/index

# ── Retrieval Settings ───────────────────────────────────────────────────────
BM25_TOP_K=50
DENSE_TOP_K=50
RERANK_TOP_K=8
